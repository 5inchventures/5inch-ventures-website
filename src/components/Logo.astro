---
/**
 * 5INCH "growth graph": five bars — one per inch — rising left to right, blue to green,
 * with a trend line across their tops ending in a green dot.
 * First paint: bars grow in once. Hover: bars re-grow one after another (spring), the trend
 * line draws across and the end dot pulses.
 */
interface Props { size?: number; withText?: boolean; static?: boolean }
const { size = 36, withText = true, static: isStatic = false } = Astro.props;

const base = 36;
const bars = [
  { x: 3, h: 9, c: '#5B7CFF', o: 0.55 },
  { x: 10, h: 14, c: '#5B7CFF', o: 0.72 },
  { x: 17, h: 19, c: '#6F8DFF', o: 0.88 },
  { x: 24, h: 25, c: '#4FB8C9', o: 1 },
  { x: 31, h: 31, c: '#3DDC97', o: 1 },
];
const w = 5;
const tops = bars.map((b) => [b.x + w / 2, base - b.h - 3.2]);
const trend = `M${tops.map(([x, y]) => `${x} ${y}`).join(' L')}`;
const end = tops[tops.length - 1];
---
<span class:list={['logo', { 'is-static': isStatic }]} style={`--s:${size}px`}>
  <svg class="mark" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true">
    {bars.map((b, i) => (
      <rect class="bar" x={b.x} y={base - b.h} width={w} height={b.h} rx="2.5" fill={b.c} opacity={b.o} style={`--i:${i}`} />
    ))}
    <path class="trend" d={trend} pathLength="100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    <circle class="dot-ring" cx={end[0]} cy={end[1]} r="2.6" fill="none" stroke="#3DDC97" stroke-width="1.2" />
    <circle class="dot" cx={end[0]} cy={end[1]} r="2.3" fill="#3DDC97" />
  </svg>
  {withText && (
    <span class="logo-text">
      <span class="logo-name"><span class="five-t">5</span>INCH</span>
      <span class="logo-sub">VENTURES</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--s) * 0.26); }
  .mark { overflow: visible; flex: none; }

  .bar { transform-box: fill-box; transform-origin: 50% 100%; animation: grow 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.1s + var(--i) * 0.08s) backwards; }
  .trend { color: var(--text); stroke-dasharray: 100; stroke-dashoffset: 0; opacity: 0.9; animation: draw 0.7s ease-out 0.6s backwards; }
  .dot { transform-box: fill-box; transform-origin: center; animation: pop 0.45s cubic-bezier(0.34, 1.7, 0.5, 1) 1.1s backwards; }
  .dot-ring { transform-box: fill-box; transform-origin: center; opacity: 0; }

  .logo:hover .bar { animation: grow 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 0.07s) backwards; }
  .logo:hover .trend { animation: draw 0.6s ease-out 0.35s backwards; }
  .logo:hover .dot { animation: pop 0.45s cubic-bezier(0.34, 1.7, 0.5, 1) 0.8s backwards; }
  .logo:hover .dot-ring { animation: ring 1.1s ease-out 0.9s; }

  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-name { font-family: var(--font-display); font-weight: 700; font-size: calc(var(--s) * 0.58); letter-spacing: -0.02em; color: var(--text); }
  .five-t { background: linear-gradient(135deg, #8fa6ff, #3ddc97); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .logo-sub { font-family: var(--font-mono); font-size: calc(var(--s) * 0.26); letter-spacing: 0.32em; color: var(--text-2); margin-top: 4px; transition: letter-spacing 0.6s var(--ease), color 0.4s; }
  .logo:hover .logo-sub { letter-spacing: 0.42em; color: var(--text); }

  :global([data-theme='light']) .five-t { background-image: linear-gradient(135deg, #3555d8, #0a9b60); }

  .is-static .bar, .is-static .trend, .is-static .dot { animation: none; }

  @keyframes grow { from { transform: scaleY(0.15); } to { transform: none; } }
  @keyframes draw { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes pop { from { transform: scale(0); } to { transform: none; } }
  @keyframes ring { 0% { opacity: 0.9; transform: scale(1); } 100% { opacity: 0; transform: scale(2.6); } }

  @media (prefers-reduced-motion: reduce) {
    .bar, .trend, .dot, .logo:hover .bar, .logo:hover .trend, .logo:hover .dot, .logo:hover .dot-ring { animation: none; }
  }
</style>
