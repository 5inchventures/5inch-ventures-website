---
import { u } from '../lib/url';
/**
 * Hero visual: what we build, not how. A phone running an ordering app, a web dashboard behind it,
 * and our published apps floating around as icon tiles. Pure HTML/CSS (no JS, no images).
 */
import { apps } from '../data/site';
const tiles = apps.map((a, i) => ({ ...a, pos: i }));
const rows = [
  { name: 'Cardio pack · 10 strips', price: '₹ 1,240', w: '72%' },
  { name: 'Vitamin D3 60K', price: '₹ 386', w: '54%' },
  { name: 'Pain relief gel 30g', price: '₹ 158', w: '63%' },
];
---
<div class="show" aria-hidden="true">
  <!-- Dashboard (web) -->
  <div class="dash">
    <div class="d-bar"><i></i><i></i><i></i><span>dashboard</span></div>
    <div class="d-body">
      <div class="d-kpis">
        <div><span>Orders today</span><b>248</b></div>
        <div><span>Deliveries</span><b class="g">231</b></div>
        <div><span>Collected</span><b class="w">₹ 4.2L</b></div>
      </div>
      <div class="d-chart">
        {[38, 54, 46, 70, 62, 84, 76, 92].map((h, i) => <span style={`--h:${h}%;--i:${i}`}></span>)}
      </div>
    </div>
  </div>

  <!-- Phone (mobile app) -->
  <div class="phone">
    <div class="p-notch"></div>
    <div class="p-screen">
      <div class="p-head"><img class="p-ic" src={u('/apps/zeromeds.webp')} alt="" width="32" height="32" decoding="async" /><div><b>Good morning</b><small>Ravi Medical, Surat</small></div></div>
      <div class="p-search">Search medicines…</div>
      <ul class="p-list">
        {rows.map((r, i) => (
          <li style={`--i:${i}`}>
            <span class="p-thumb"></span>
            <span class="p-txt"><b>{r.name}</b><i style={`width:${r.w}`}></i></span>
            <span class="p-price">{r.price}</span>
            <span class="p-add">+</span>
          </li>
        ))}
      </ul>
      <div class="p-cart"><span>3 items</span><b>Place order →</b></div>
      <div class="p-toast"><span>✓</span> Order placed</div>
    </div>
  </div>

  <!-- Floating app tiles -->
  {tiles.map((t) => (
    <img class={`tile t${t.pos}`} style={`--a:${t.color}`} src={t.icon} alt="" width="50" height="50" decoding="async" />
  ))}
</div>

<style>
  .show { position: relative; height: 520px; }

  .dash { position: absolute; left: 0; top: 46px; width: 74%; border-radius: 18px; border: 1px solid var(--line-strong); background: rgba(13, 18, 32, 0.92); box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7); overflow: hidden; transform: perspective(1400px) rotateY(10deg) rotateX(4deg); transform-origin: left center; }
  .d-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .d-bar i { width: 9px; height: 9px; border-radius: 50%; background: #2a3247; }
  .d-bar span { margin-left: 8px; font: 500 11px var(--font-mono); color: var(--muted); }
  .d-body { padding: 16px; }
  .d-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .d-kpis div { padding: 10px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.04); display: flex; flex-direction: column; gap: 2px; }
  .d-kpis span { font-size: 10.5px; color: var(--muted); }
  .d-kpis b { font: 600 19px var(--font-display); color: #fff; }
  .d-kpis b.g { color: var(--signal); }
  .d-kpis b.w { color: var(--warm); }
  .d-chart { display: flex; align-items: flex-end; gap: 10px; height: 150px; margin-top: 16px; padding: 12px; border-radius: 12px; background: repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 30px); }
  .d-chart span { flex: 1; height: var(--h); border-radius: 6px 6px 2px 2px; background: linear-gradient(180deg, #7d97ff, rgba(91, 124, 255, 0.25)); transform-origin: bottom; animation: grow 1.2s var(--ease) calc(0.4s + var(--i) * 0.07s) backwards; }
  .d-chart span:nth-child(8) { background: linear-gradient(180deg, var(--signal), rgba(61, 220, 151, 0.25)); }

  .phone { position: absolute; right: 4%; top: 0; width: 236px; height: 484px; padding: 10px; border-radius: 40px; background: linear-gradient(160deg, #2a3350, #0d1222); box-shadow: 0 0 0 1px rgba(255,255,255,.12), 0 50px 90px -30px rgba(0, 0, 0, 0.8), 0 0 80px -20px rgba(91, 124, 255, 0.45); animation: float 7s ease-in-out infinite; }
  .p-notch { position: absolute; left: 50%; top: 18px; width: 70px; height: 20px; border-radius: 12px; background: #05070d; translate: -50% 0; z-index: 2; }
  .p-screen { position: relative; height: 100%; border-radius: 31px; overflow: hidden; background: linear-gradient(180deg, #f6f8ff, #eef2fb); padding: 44px 14px 14px; display: flex; flex-direction: column; gap: 10px; color: #0b1530; }
  .p-head { display: flex; align-items: center; gap: 10px; }
  .p-ic { width: 32px; height: 32px; border-radius: 10px; object-fit: cover; }
  .p-head b { display: block; font: 600 13px var(--font-display); }
  .p-head small { font-size: 10px; color: #5b6785; }
  .p-search { padding: 9px 12px; border-radius: 12px; background: #fff; border: 1px solid #e3e8f4; font-size: 11px; color: #56617d; }
  .p-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .p-list li { display: grid; grid-template-columns: 30px 1fr auto 22px; gap: 8px; align-items: center; padding: 8px; border-radius: 12px; background: #fff; box-shadow: 0 4px 12px rgba(30, 45, 110, 0.06); animation: slide 0.7s var(--ease) calc(0.9s + var(--i) * 0.12s) backwards; }
  .p-thumb { width: 30px; height: 30px; border-radius: 8px; background: linear-gradient(135deg, #dfe6ff, #c8d4ff); }
  .p-txt { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .p-txt b { font-size: 10.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .p-txt i { height: 4px; border-radius: 2px; background: #e3e8f4; }
  .p-price { font: 600 10.5px var(--font-display); }
  .p-add { width: 22px; height: 22px; border-radius: 7px; display: grid; place-items: center; background: #5b7cff; color: #fff; font-weight: 700; font-size: 13px; }
  .p-list li:nth-child(1) .p-add { animation: tap 6s ease-in-out 2.2s infinite; }
  .p-cart { margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; border-radius: 14px; background: #0b1530; color: #fff; font-size: 11px; }
  .p-cart b { font: 600 12px var(--font-display); color: var(--signal); }
  .p-toast { position: absolute; left: 50%; top: 52px; translate: -50% 0; display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #0b1530; color: #fff; font-size: 11px; font-weight: 600; white-space: nowrap; box-shadow: 0 10px 24px rgba(11, 21, 48, 0.3); opacity: 0; animation: toast 6s ease-in-out 2.6s infinite; }
  .p-toast span { width: 16px; height: 16px; border-radius: 50%; display: grid; place-items: center; background: var(--signal); color: #04210f; font-size: 10px; }

  .tile { position: absolute; width: 50px; height: 50px; border-radius: 14px; object-fit: cover; background: #fff; box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 14px 30px -10px var(--a); animation: bob 6s ease-in-out infinite; }
  .t0 { left: 58%; top: -6px; animation-delay: -1s; }
  .t1 { left: -2%; top: 8px; width: 42px; height: 42px; animation-delay: -2.5s; }
  .t2 { left: 6%; bottom: 40px; animation-delay: -4s; }
  .t3 { right: -2%; top: 150px; width: 44px; height: 44px; animation-delay: -1.8s; }
  .t4 { left: 44%; bottom: 6px; width: 46px; height: 46px; animation-delay: -3.2s; }
  .t5 { right: 0; bottom: 30px; width: 40px; height: 40px; animation-delay: -0.6s; }
  .t6 { left: 30%; top: 2px; width: 38px; height: 38px; animation-delay: -5s; }

  @keyframes grow { from { transform: scaleY(0.1); } }
  @keyframes slide { from { opacity: 0; transform: translateX(24px); } }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(2deg); } 50% { transform: translateY(-12px) rotate(0.5deg); } }
  @keyframes bob { 0%, 100% { translate: 0 0; rotate: 0deg; } 50% { translate: 0 -10px; rotate: -4deg; } }
  @keyframes tap { 0%, 30%, 40%, 100% { transform: scale(1); } 34% { transform: scale(0.8); background: var(--signal); } }
  @keyframes toast { 0%, 34% { opacity: 0; transform: translateY(-8px); } 40%, 70% { opacity: 1; transform: none; } 78%, 100% { opacity: 0; transform: translateY(-8px); } }

  @media (max-width: 1000px) {
    .show { height: 500px; max-width: 560px; margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .show { height: 440px; }
    .dash { width: 86%; top: 70px; }
    .d-chart { height: 110px; }
    .phone { width: 220px; height: 410px; right: 0; border-radius: 34px; }
    .p-screen { border-radius: 26px; padding: 40px 10px 12px; gap: 8px; }
    .p-list li { grid-template-columns: 1fr auto 22px; gap: 6px; }
    .p-thumb { display: none; }
    .p-txt b { font-size: 10px; }
    .dash { width: 80%; }
    .p-list li:nth-child(3) { display: none; }
    .t6, .t1 { display: none; }
    .t0 { left: 2%; top: 14px; width: 42px; height: 42px; }
  }
</style>
